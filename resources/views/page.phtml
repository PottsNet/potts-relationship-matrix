                        <input class="form-check-input" type="checkbox" id="potts-rm-fit-width" checked>
                        <label class="form-check-label" for="potts-rm-fit-width"><?= I18N::translate('Fit chart to width') ?></label>
                    </div>
                </div>

                <div class="potts-rm-pedigree-viewport" id="potts-rm-pedigree-viewport">
                    <div class="potts-rm-pedigree-sizer" id="potts-rm-pedigree-sizer">
                        <div class="potts-rm-pedigree-canvas" id="potts-rm-pedigree-canvas">
                            <svg class="potts-rm-pedigree-connectors" id="potts-rm-pedigree-connectors" aria-hidden="true"></svg>
                            <div class="potts-rm-pedigree-cards" id="potts-rm-pedigree-cards">
                                <?php foreach ($pedigree_graph['nodes'] as $node) : ?>
                                    <?php $individual = $pedigree_individuals[$node['id']] ?? null ?>
                                    <?php if (!$individual instanceof Individual) : ?>
                                        <?php continue ?>
                                    <?php endif ?>
                                    <div
                                        class="potts-rm-pedigree-card<?= !empty($node['endpoint']) ? ' is-endpoint' : '' ?><?= !empty($node['common']) ? ' is-common' : '' ?>"
                                        data-node-id="<?= e((string) $node['id']) ?>"
                                        data-paths="<?= e(implode(',', $node['paths'])) ?>"
                                    >
                                        <?php if (!empty($node['endpointLabel'])) : ?>
                                            <span class="potts-rm-pedigree-tag potts-rm-pedigree-tag-endpoint"><?= e((string) $node['endpointLabel']) ?></span>
                                        <?php endif ?>
                                        <?php if (!empty($node['common'])) : ?>
                                            <span class="potts-rm-pedigree-tag potts-rm-pedigree-tag-common"><?= I18N::translate('Common ancestor') ?></span>
                                        <?php endif ?>
                                        <?= view('chart-box', ['individual' => $individual]) ?>
                                    </div>
                                <?php endforeach ?>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="potts-rm-pedigree-legend">
                    <span><?= I18N::translate('Selected people') ?></span>
                    <span class="common"><?= I18N::translate('Common ancestor') ?></span>
                    <span class="spouse"><?= I18N::translate('Spouse link') ?></span>
                </div>

                <h4 class="h5 mt-4"><?= I18N::translate('Paths') ?></h4>
                <div class="potts-rm-paths">
                    <?php foreach (array_slice($detail['paths'], 0, 24) as $index => $path) : ?>
                        <article class="potts-rm-path">
                            <div class="potts-rm-path-title">
                                <?= I18N::translate('Path %s', I18N::number($index + 1)) ?> — <?= e((string) $path['name']) ?>
                            </div>
                            <span class="potts-rm-badge">
                                <?= I18N::plural('%s family step', '%s family steps', (int) $path['steps'], I18N::number((int) $path['steps'])) ?>
                            </span>
                            <?php if (is_int($path['l1'] ?? null) && is_int($path['l2'] ?? null)) : ?>
                                <span class="potts-rm-badge">
                                    <?= e((string) $path['l1']) ?> ↑ / <?= e((string) $path['l2']) ?> ↓
                                </span>
                            <?php endif ?>
                            <?php if (is_string($path['common_ancestor_name'] ?? null) && $path['common_ancestor_name'] !== '') : ?>
                                <div class="mt-2">
                                    <strong><?= I18N::translate('Common ancestor') ?>:</strong>
                                    <?= e((string) $path['common_ancestor_name']) ?>
                                </div>
                            <?php endif ?>
                            <?php if (!empty($path['contains_spouse_link'])) : ?>
                                <div class="potts-rm-note mt-2"><?= I18N::translate('This route includes a spouse-to-spouse family link.') ?></div>
                            <?php endif ?>
                        </article>
                    <?php endforeach ?>
                </div>
            <?php endif ?>
        </section>
    <?php endif ?>
</div>

<script>
(function () {
    'use strict';

    const scope = document.getElementById('potts-rm-scope');
    const recursionControl = document.getElementById('potts-rm-recursion-control');

    function updateRecursionVisibility() {
        if (!scope || !recursionControl) {
            return;
        }
        recursionControl.style.opacity = scope.value === 'all' ? '1' : '.55';
    }

    if (scope) {
        scope.addEventListener('change', updateRecursionVisibility);
        updateRecursionVisibility();
    }

    const graph = <?= $pedigree_graph_json ?>;
    const viewport = document.getElementById('potts-rm-pedigree-viewport');
    const sizer = document.getElementById('potts-rm-pedigree-sizer');
    const canvas = document.getElementById('potts-rm-pedigree-canvas');
    const connectorSvg = document.getElementById('potts-rm-pedigree-connectors');
    const cardsLayer = document.getElementById('potts-rm-pedigree-cards');
    const pathSelector = document.getElementById('potts-rm-chart-paths');
    const showPhotos = document.getElementById('potts-rm-show-photos');
    const showDetails = document.getElementById('potts-rm-show-details');
    const highlightCommon = document.getElementById('potts-rm-highlight-common');
    const fitWidth = document.getElementById('potts-rm-fit-width');

    if (!graph || !viewport || !sizer || !canvas || !connectorSvg || !cardsLayer) {
        return;
    }

    const cardElements = new Map();
    cardsLayer.querySelectorAll('[data-node-id]').forEach(card => {
        cardElements.set(card.dataset.nodeId, card);
    });

    const nodeMap = new Map(graph.nodes.map(node => [node.id, node]));
    let canvasWidth = 900;
    let canvasHeight = 480;

    function activePathIndexes() {
        if (pathSelector && pathSelector.value === 'closest') {
            return new Set([0]);
        }
        return new Set(Array.from({length: graph.pathCountShown || 1}, (_, index) => index));
    }

    function edgeIsActive(edge, activePaths) {
        return Array.isArray(edge.paths) && edge.paths.some(path => activePaths.has(path));
    }

    function nodeIsActive(node, activePaths, activeEdges) {
        if (node.id === graph.first || node.id === graph.second) {
            return true;
        }
        if (Array.isArray(node.paths) && node.paths.some(path => activePaths.has(path))) {
            return true;
        }
        return activeEdges.some(edge => edge.from === node.id || edge.to === node.id);
    }

    function applyDisplayOptions() {
        viewport.classList.toggle('hide-photos', showPhotos && !showPhotos.checked);
        viewport.classList.toggle('hide-details', showDetails && !showDetails.checked);
        viewport.classList.toggle('no-common-highlight', highlightCommon && !highlightCommon.checked);
    }

    function buildLayout() {
        applyDisplayOptions();

        const activePaths = activePathIndexes();
        const activeEdges = graph.edges.filter(edge => edgeIsActive(edge, activePaths));
        const activeNodes = graph.nodes.filter(node => nodeIsActive(node, activePaths, activeEdges) && cardElements.has(node.id));
        const activeIds = new Set(activeNodes.map(node => node.id));

        cardElements.forEach((element, id) => {
            element.style.display = activeIds.has(id) ? '' : 'none';
        });

        const adjacency = new Map();
        activeNodes.forEach(node => adjacency.set(node.id, []));
        activeEdges.forEach(edge => {
            if (activeIds.has(edge.from) && activeIds.has(edge.to)) {
                adjacency.get(edge.from).push(edge.to);
                adjacency.get(edge.to).push(edge.from);
            }
        });

        const levels = new Map();
        const queue = [];
        if (activeIds.has(graph.first)) {
            levels.set(graph.first, 0);
            queue.push(graph.first);
        }

        for (let cursor = 0; cursor < queue.length; cursor++) {
            const current = queue[cursor];
            const currentLevel = levels.get(current) || 0;
            (adjacency.get(current) || []).forEach(next => {
                if (!levels.has(next)) {
                    levels.set(next, currentLevel + 1);
                    queue.push(next);
                }
            });
        }

        let fallbackLevel = Math.max(0, ...Array.from(levels.values()));
        activeNodes.forEach(node => {
            if (!levels.has(node.id)) {
                fallbackLevel += 1;
                levels.set(node.id, fallbackLevel);
            }
        });

        const columns = new Map();
        activeNodes.forEach(node => {
            const level = levels.get(node.id) || 0;
            if (!columns.has(level)) {
                columns.set(level, []);
            }
            columns.get(level).push(node);
        });

        columns.forEach(nodes => {
            nodes.sort((a, b) => {
                const aPath = Math.min(...(a.paths || [999]));
                const bPath = Math.min(...(b.paths || [999]));
                if (aPath !== bPath) {
                    return aPath - bPath;
                }
                if (a.common !== b.common) {
                    return a.common ? -1 : 1;
                }
                return String(a.xref).localeCompare(String(b.xref));
            });
        });

        const cardWidth = window.matchMedia('(max-width: 900px)').matches ? 280 : 310;
        const columnGap = 105;
        const columnWidth = cardWidth + columnGap;
        const topPadding = 34;
        const leftPadding = 34;
        const rowGap = 28;
        const positions = new Map();
        let maxColumnHeight = 0;
        let maxLevel = 0;

        Array.from(columns.keys()).sort((a, b) => a - b).forEach(level => {
            maxLevel = Math.max(maxLevel, level);
            let y = topPadding;
            (columns.get(level) || []).forEach(node => {
                const card = cardElements.get(node.id);
                if (!card) {
                    return;
                }
                card.style.left = `${leftPadding + level * columnWidth}px`;
                card.style.top = `${y}px`;
                const height = Math.max(90, card.offsetHeight);
                positions.set(node.id, {
                    x: leftPadding + level * columnWidth,
                    y: y,
                    width: cardWidth,
                    height: height
                });
                y += height + rowGap;
            });
            maxColumnHeight = Math.max(maxColumnHeight, y + topPadding);
        });

        canvasWidth = Math.max(900, leftPadding * 2 + (maxLevel + 1) * cardWidth + maxLevel * columnGap);
        canvasHeight = Math.max(480, maxColumnHeight);
        canvas.style.width = `${canvasWidth}px`;
        canvas.style.height = `${canvasHeight}px`;
        cardsLayer.style.width = `${canvasWidth}px`;
        cardsLayer.style.height = `${canvasHeight}px`;
        connectorSvg.setAttribute('width', String(canvasWidth));
        connectorSvg.setAttribute('height', String(canvasHeight));
        connectorSvg.setAttribute('viewBox', `0 0 ${canvasWidth} ${canvasHeight}`);
        connectorSvg.innerHTML = '';

        const NS = 'http://www.w3.org/2000/svg';
        activeEdges.forEach(edge => {
            const from = positions.get(edge.from);
            const to = positions.get(edge.to);
            if (!from || !to) {
                return;
            }

            let start = from;
            let end = to;
            if (start.x > end.x) {
                start = to;
                end = from;
            }

            const x1 = start.x + start.width;
            const y1 = start.y + start.height / 2;
            const x2 = end.x;
            const y2 = end.y + end.height / 2;
            const middleX = x1 + Math.max(28, (x2 - x1) / 2);
            const path = document.createElementNS(NS, 'path');
            path.setAttribute('d', `M ${x1} ${y1} H ${middleX} V ${y2} H ${x2}`);
            path.setAttribute('class', `potts-rm-pedigree-edge is-${edge.kind || 'family'}`);
            connectorSvg.appendChild(path);
        });

        applyScale();
    }

    function applyScale() {
        let scale = 1;
        if (fitWidth && fitWidth.checked && canvasWidth > 0) {
            scale = Math.min(1, Math.max(.28, (viewport.clientWidth - 22) / canvasWidth));
        }
        canvas.style.transform = `scale(${scale})`;
        sizer.style.width = `${Math.max(viewport.clientWidth, canvasWidth * scale)}px`;
        sizer.style.height = `${Math.max(480, canvasHeight * scale)}px`;
    }

    [pathSelector, showPhotos, showDetails, highlightCommon].forEach(control => {
        if (control) {
            control.addEventListener('change', () => {
                window.requestAnimationFrame(() => buildLayout());
            });
        }
    });

    if (fitWidth) {
        fitWidth.addEventListener('change', applyScale);
    }

    window.addEventListener('resize', () => {
        window.requestAnimationFrame(() => buildLayout());
    });

    window.requestAnimationFrame(() => buildLayout());
})();
</script>
