<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Family;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Registry;

/** @var string $title */
/** @var \Fisharebest\Webtrees\Tree $tree */
/** @var Individual $route_individual */
/** @var array<int,Individual|null> $slots */
/** @var array<int,Individual> $selected */
/** @var array<int,array<int,array<string,mixed>|null>> $matrix */
/** @var string $scope */
/** @var int $recursion */
/** @var int $max_people */
/** @var string $action_url */
/** @var array<string,mixed>|null $detail */
/** @var string $detail_key */
/** @var array<string,string> $detail_urls */
/** @var string $clear_detail_url */
/** @var string $graph_json */
/** @var string $version */

$pedigree_graph = null;
$pedigree_individuals = [];

if (is_array($detail) && (int) ($detail['path_count'] ?? 0) > 0) {
    $nodes = [];
    $edges = [];
    $common = [];
    $paths = array_slice($detail['paths'], 0, 12);

    foreach ($paths as $path_index => $path) {
        $common_xref = $path['common_ancestor_xref'] ?? null;
        if (is_string($common_xref) && $common_xref !== '') {
            $common[$common_xref] = true;
        }

        $path_nodes = is_array($path['nodes'] ?? null) ? $path['nodes'] : [];

        for ($i = 0; $i < count($path_nodes); $i += 2) {
            $xref = (string) $path_nodes[$i];
            $node_id = 'I|' . $xref;
            $individual = Registry::individualFactory()->make($xref, $tree);

            if (!$individual instanceof Individual || !$individual->canShow()) {
                continue;
            }

            $pedigree_individuals[$node_id] = $individual;

            if (!isset($nodes[$node_id])) {
                $nodes[$node_id] = [
                    'id' => $node_id,
                    'xref' => $xref,
                    'common' => false,
                    'endpoint' => in_array($xref, [(string) $detail['first_xref'], (string) $detail['second_xref']], true),
                    'endpointLabel' => $xref === (string) $detail['first_xref'] ? I18N::translate('Person 1') : ($xref === (string) $detail['second_xref'] ? I18N::translate('Person 2') : ''),
                    'paths' => [],
                ];
            }

            $nodes[$node_id]['common'] = isset($common[$xref]) || !empty($nodes[$node_id]['common']);
            $nodes[$node_id]['paths'][] = $path_index;

            if ($i + 2 >= count($path_nodes)) {
                continue;
            }

            $family_xref = (string) $path_nodes[$i + 1];
            $to_xref = (string) $path_nodes[$i + 2];
            $to_id = 'I|' . $to_xref;
            $kind = 'family';

            $family = Registry::familyFactory()->make($family_xref, $tree);
            if ($family instanceof Family && $family->canShow()) {
                $spouse_xrefs = $family->spouses()
                    ->filter(static fn (Individual $person): bool => $person->canShow())
                    ->map(static fn (Individual $person): string => $person->xref())
                    ->all();
                $child_xrefs = $family->children()
                    ->filter(static fn (Individual $person): bool => $person->canShow())
                    ->map(static fn (Individual $person): string => $person->xref())
                    ->all();

                $from_spouse = in_array($xref, $spouse_xrefs, true);
                $to_spouse = in_array($to_xref, $spouse_xrefs, true);
                $from_child = in_array($xref, $child_xrefs, true);
                $to_child = in_array($to_xref, $child_xrefs, true);

                if ($from_spouse && $to_spouse) {
                    $kind = 'spouse';
                } elseif (($from_spouse && $to_child) || ($from_child && $to_spouse)) {
                    $kind = 'parent';
                } elseif ($from_child && $to_child) {
                    $kind = 'sibling';
                }
            }

            $edge_parts = [$node_id, $to_id];
            sort($edge_parts);
            $edge_key = implode('|', $edge_parts) . '|' . $family_xref;

            if (!isset($edges[$edge_key])) {
                $edges[$edge_key] = [
                    'from' => $node_id,
                    'to' => $to_id,
                    'family' => $family_xref,
                    'kind' => $kind,
                    'paths' => [],
                ];
            }

            $edges[$edge_key]['paths'][] = $path_index;
        }
    }

    foreach ($nodes as &$node) {
        $node['paths'] = array_values(array_unique($node['paths']));
    }
    unset($node);

    foreach ($edges as &$edge) {
        $edge['paths'] = array_values(array_unique($edge['paths']));
    }
    unset($edge);

    $pedigree_graph = [
        'first' => 'I|' . (string) $detail['first_xref'],
        'second' => 'I|' . (string) $detail['second_xref'],
        'nodes' => array_values($nodes),
        'edges' => array_values($edges),
        'pathCountShown' => count($paths),
        'pathCountTotal' => (int) $detail['path_count'],
    ];
}

$pedigree_graph_json = $pedigree_graph === null
    ? 'null'
    : json_encode($pedigree_graph, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
?>

