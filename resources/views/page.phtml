<script>
(function () {
    'use strict';

    const scope = document.getElementById('potts-rm-scope');
    const recursionControl = document.getElementById('potts-rm-recursion-control');

    function updateRecursionVisibility() {
        if (!scope || !recursionControl) {
            return;
        }
        recursionControl.style.opacity = scope.value === 'all' ? '1' : '.55';
    }

    if (scope) {
        scope.addEventListener('change', updateRecursionVisibility);
        updateRecursionVisibility();
    }

    const data = <?= $graph_json ?>;
    const svg = document.getElementById('potts-rm-graph');

    if (!svg || !data || !Array.isArray(data.nodes) || data.nodes.length === 0) {
        return;
    }

    const NS = 'http://www.w3.org/2000/svg';
    const nodeMap = new Map(data.nodes.map(node => [node.id, node]));
    const adjacency = new Map();

    data.nodes.forEach(node => adjacency.set(node.id, []));
    data.edges.forEach(edge => {
        if (adjacency.has(edge.from) && adjacency.has(edge.to)) {
            adjacency.get(edge.from).push(edge.to);
            adjacency.get(edge.to).push(edge.from);
        }
    });

    const level = new Map();
    const queue = [data.first];
    level.set(data.first, 0);

    for (let cursor = 0; cursor < queue.length; cursor++) {
        const current = queue[cursor];
        const currentLevel = level.get(current) || 0;
        (adjacency.get(current) || []).forEach(next => {
            if (!level.has(next)) {
                level.set(next, currentLevel + 1);
                queue.push(next);
            }
        });
    }

    let maxLevel = 0;
    data.nodes.forEach(node => {
        if (!level.has(node.id)) {
            level.set(node.id, maxLevel + 1);
        }
        maxLevel = Math.max(maxLevel, level.get(node.id));
    });

    const columns = new Map();
    data.nodes.forEach(node => {
        const column = level.get(node.id) || 0;
        if (!columns.has(column)) {
            columns.set(column, []);
        }
        columns.get(column).push(node);
    });

    columns.forEach(nodes => {
        nodes.sort((a, b) => {
            if (a.type !== b.type) {
                return a.type === 'individual' ? -1 : 1;
            }
            return String(a.label).localeCompare(String(b.label));
        });
    });

    const columnWidth = 205;
    const side = 115;
    const width = Math.max(760, side * 2 + maxLevel * columnWidth);
    let maxRows = 1;
    columns.forEach(nodes => { maxRows = Math.max(maxRows, nodes.length); });
    const height = Math.max(430, 110 + maxRows * 100);
    const positions = new Map();

    columns.forEach((nodes, column) => {
        nodes.forEach((node, index) => {
            positions.set(node.id, {
                x: side + column * columnWidth,
                y: ((index + 1) * height) / (nodes.length + 1)
            });
        });
    });

    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');

    function el(name, attrs) {
        const element = document.createElementNS(NS, name);
        Object.entries(attrs || {}).forEach(([key, value]) => element.setAttribute(key, String(value)));
        return element;
    }

    data.edges.forEach(edge => {
        const from = positions.get(edge.from);
        const to = positions.get(edge.to);
        if (!from || !to) {
            return;
        }
        svg.appendChild(el('line', {
            x1: from.x,
            y1: from.y,
            x2: to.x,
            y2: to.y,
            class: 'potts-rm-edge'
        }));
    });

    data.nodes.forEach(node => {
        const pos = positions.get(node.id);
        if (!pos) {
            return;
        }

        if (node.type === 'family') {
            const group = el('g', {transform: `translate(${pos.x} ${pos.y})`});
            group.appendChild(el('rect', {
                x: -8,
                y: -8,
                width: 16,
                height: 16,
                rx: 2,
                transform: 'rotate(45)',
                class: 'potts-rm-family-node'
            }));
            const title = el('title');
            title.textContent = node.label || 'Family';
            group.appendChild(title);
            svg.appendChild(group);
            return;
        }

        const classes = ['potts-rm-person-node'];
        if (node.endpoint) classes.push('endpoint');
        if (node.common) classes.push('common');

        const group = el('g', {
            transform: `translate(${pos.x} ${pos.y})`,
            class: classes.join(' ')
        });

        if (node.url) {
            group.setAttribute('data-url', node.url);
            group.setAttribute('tabindex', '0');
            group.setAttribute('role', 'link');
        }

        group.appendChild(el('rect', {x: -82, y: -27, width: 164, height: 54, rx: 8}));
        const text = el('text', {x: 0, y: 4, 'text-anchor': 'middle'});
        const label = String(node.label || node.xref || '');
        text.textContent = label.length > 24 ? label.slice(0, 23) + '…' : label;
        group.appendChild(text);

        const title = el('title');
        title.textContent = label;
        group.appendChild(title);

        function openNode() {
            if (node.url) {
                window.location.href = node.url;
            }
        }

        group.addEventListener('click', openNode);
        group.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                openNode();
            }
        });

        svg.appendChild(group);
    });
})();
</script>
